# 인라인 # 주석 금지 — config/env_bootstrap.py 는 KEY=VALUE 만 파싱해 값 뒤의 "# ..." 를 값에 포함시킨다. 주석은 이렇게 별도 줄에.
# DB 접속 — 아래 값은 db/connection.py 코드 기본값과 같다(.env 가 없어도 이 값으로 붙는다).
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=kis_template
TIMESCALE_USER=robotrader
# 코드 기본값 1234(db/connection.py). 실제 운영 암호는 여기 적지 않는다.
TIMESCALE_PASSWORD=1234
# rs_leader 미조정 기업행위 배제 가드 — off|shadow|live (코드 기본 shadow · live 발효 2026-09-17 · docs/prereg_2026-09-16_rsleader_exclusion_live.md)
RS_LEADER_CORP_ACTION_MODE=shadow
# 실전 전용 «기업행위 의심» 기준가 경보 끄기(판정은 원래 불변·경보만) — off|0|false|no|disable|disabled 면 끔, 그 외(미설정·오타 포함)는 켬. 코드: core/trading/corp_action_price_alert.py
# CORP_ACTION_PRICE_ALERT=off
